{
  "name": "autoskip",
  "version": "1.1.0",
  "private": true,
  "description": "Free and open-source browser extension that remembers repetitive streaming playback decisions and performs them automatically.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e",
    "package": "npm run build && node scripts/package.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.287",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
