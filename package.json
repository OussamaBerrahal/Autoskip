{
  "name": "autoskip",
  "version": "1.0.0",
  "private": true,
  "description": "Free and open-source browser extension that remembers repetitive streaming playback decisions and performs them automatically.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
